# ---------------------------------------------------------------- base
# PostgreSQL. En production : chaîne de connexion Supabase « Transaction pooler » (port 6543).
DATABASE_URL=postgres://postgres@localhost:54330/postgres
DATABASE_POOL_MAX=5
APP_URL=http://localhost:3000
# 32 octets aléatoires en base64 : openssl rand -base64 32  (chiffre les mots de passe SMTP et secrets de webhooks)
ENCRYPTION_KEY=
# Secret partagé avec Vercel Cron (Authorization: Bearer …) : openssl rand -hex 32
CRON_SECRET=
# Adresses e-mail du ou des propriétaires de RelancePro (accès à /admin)
ADMIN_EMAILS=

# ------------------------------------------- e-mails de la plateforme
# Toute URL SMTP (Brevo, Resend, Postmark, OVH…). Vide = e-mails conservés dans /dev/outbox (développement).
PLATFORM_SMTP_URL=
PLATFORM_EMAIL_FROM="RelancePro <no-reply@votre-domaine.fr>"
SUPPORT_EMAIL=

# ---------------------------------------------------------------- IA
# anthropic | openai | none — sans clé, RelancePro AI fonctionne en mode déterministe.
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------ Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# ------------------------------------------------- OAuth (facultatif)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ------------------------------------------------------------ sécurité
# Coupe tous les envois automatiques de la plateforme (interrupteur global).
AUTOMATION_DISABLED=false
