{
  "name": "relancepro",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "RelancePro — l'IA qui transforme les prospects oubliés en opportunités commerciales.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
