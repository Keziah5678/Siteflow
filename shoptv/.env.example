# ─────────────────────────────────────────────────────────────
# SHOPTV — variables d'environnement
# Copiez ce fichier en `.env` puis renseignez les valeurs.
# Seules les variables préfixées par EXPO_PUBLIC_ sont exposées à l'app.
# NE METTEZ JAMAIS de clé secrète (service_role, sk_live_…) ici.
# ─────────────────────────────────────────────────────────────

# Projet Supabase (Settings → API)
EXPO_PUBLIC_SUPABASE_URL=
# Clé publishable (sb_publishable_…) ou anon key — publique par conception, protégée par RLS
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Stripe — clé publishable uniquement (pk_test_… / pk_live_…)
# (injectée dans l'app via app.config.ts → extra.stripePublishableKey)
STRIPE_PUBLISHABLE_KEY=

# Connexion Google (optionnel) — client IDs OAuth publics
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false
