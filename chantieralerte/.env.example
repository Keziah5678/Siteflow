# =============================================================================
# ChantierAlerte — variables d'environnement
# En production, ces valeurs sont des « Secrets » GitHub (voir README, étape 6).
# En local : copiez ce fichier en .env.local. Ne commitez JAMAIS de vraie clé.
# =============================================================================

# Supabase — Project Settings → API
SUPABASE_URL=https://VOTRE-PROJET.supabase.co
SUPABASE_ANON_KEY=            # publique (protégée par la sécurité RLS)
SUPABASE_SERVICE_ROLE_KEY=    # SECRÈTE : uniquement dans GitHub Secrets

# Brevo — SMTP & API → Clés API
BREVO_API_KEY=
MAIL_FROM=alertes@votre-domaine.fr   # adresse d'expéditeur vérifiée dans Brevo
MAIL_FROM_NAME=ChantierAlerte
MAIL_MODE=brevo                      # brevo | log (tester sans envoyer) | outbox (local)
MAIL_DAILY_LIMIT=290                 # offre gratuite Brevo : 300/jour

# Stripe (facultatif au début) — Développeurs → Clés API (clé « sk_ »)
# Sert uniquement à vérifier chaque matin qui a payé.
STRIPE_SECRET_KEY=

# Le lien de paiement Stripe et l'adresse du site se règlent dans config/site.json
