# ==========================================================================
# SEEDFLOW - Variables d'environnement
# Copiez ce fichier en .env.local et renseignez vos propres valeurs.
# Ne jamais committer .env.local ni exposer une clé secrète côté client.
# ==========================================================================

# --- Supabase (base de données, authentification, RLS) ---------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (orchestrateur IA : planification, contenu, SEO, assistant) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Génération d'images IA (abstraction ImageGenerationService) -----------
# Fournisseur optionnel. Laisser vide désactive la génération d'images IA
# (le système utilise alors des emplacements réservés, jamais des images
# génériques factices présentées comme réelles).
IMAGE_GENERATION_PROVIDER=
IMAGE_GENERATION_API_KEY=

# --- Stripe (facturation) ---------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Application -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
