# --- Supabase (laisser vide = mode local : données stockées dans le navigateur) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- IA (serveur uniquement, jamais exposé au navigateur) ---
# Fournisseur texte : "openai" | "anthropic" | "none"
ARTHENIS_TEXT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024
ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=claude-opus-5-5

# --- Garde-fous de coût ---
ARTHENIS_DAILY_IMAGE_LIMIT=20
ARTHENIS_DAILY_TEXT_LIMIT=300
ARTHENIS_RATE_LIMIT_PER_MINUTE=30

# Sans Supabase (mode local), les routes IA payantes sont coupées en production
# pour éviter tout usage anonyme. Mettre "true" seulement pour une démo privée.
ARTHENIS_ALLOW_ANONYMOUS_AI=false
