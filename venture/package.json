    "next": "^16.3.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "stripe": "^23.2.0",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
