# =============================================================================
# VENTURE — variables d'environnement
# Copier en .env.local (jamais commité). Les variables NEXT_PUBLIC_* sont
# exposées au navigateur : n'y mettez JAMAIS de secret.
# =============================================================================

# --- Supabase (obligatoire) ---------------------------------------------------
# Local : valeurs affichées par `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVEUR UNIQUEMENT — contourne la RLS. Utilisée pour : webhooks Stripe,
# comptabilité IA, limitation de débit, suppression de compte.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Style de carte MapLibre (gratuit, sans clé). Remplaçable par tout style compatible.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# --- VENTURE AI (facultatif) ----------------------------------------------------
# Sans clé, l'IA est désactivée proprement (suggestions automatiques à base de règles).
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Modèle par défaut : claude-opus-5-5. Effort : low | medium | high.
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium

# --- Stripe (facultatif, MODE TEST) --------------------------------------------
# Sans clés, les abonnements affichent « Bientôt disponible ».
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Garde-fou : une clé sk_live_ est refusée en production sans ceci.
STRIPE_ALLOW_LIVE=false
